<% content_for :title, "プロフィール - sengen" %>

<div class="overflow-x-hidden">

  <!-- フラッシュメッセージ -->
  <% if notice %>
    <div class="mx-4 mt-4 bg-blue-50 border border-blue-200 text-blue-700 rounded-xl px-4 py-3 text-sm flex items-center justify-between">
      <span><%= notice %></span>
      <button onclick="this.parentElement.remove()" class="ml-3 text-blue-400 hover:text-blue-600 transition-colors">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  <% end %>

  <!-- プロフィール -->
  <div class="px-4 pt-4 pb-3 border-b border-gray-100">
    <div class="flex items-start gap-4">
      <%= render "shared/avatar", user: current_user, size: :lg %>
      <div class="flex-1 min-w-0">
        <div class="flex items-center justify-between mb-1">
          <p class="font-bold text-gray-900 text-lg leading-tight"><%= current_user.name %></p>
          <%= link_to edit_profile_path, class: "text-xs text-gray-500 border border-gray-300 rounded-full px-3 py-1 hover:bg-gray-50 transition-colors" do %>
            編集
          <% end %>
        </div>
        <% if current_user.bio.present? %>
          <p class="text-gray-500 text-sm leading-relaxed mb-2"><%= current_user.bio %></p>
        <% else %>
          <p class="text-gray-300 text-sm mb-2">一言メッセージを追加しましょう</p>
        <% end %>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
          <%= link_to followings_user_path(current_user), class: "hover:underline" do %>
            <span class="font-bold text-gray-900"><%= current_user.followings.count %></span><span class="text-gray-500 ml-0.5">フォロー</span>
          <% end %>
          <%= link_to followers_user_path(current_user), class: "hover:underline" do %>
            <span class="font-bold text-gray-900"><%= current_user.followers.count %></span><span class="text-gray-500 ml-0.5">フォロワー</span>
          <% end %>
          <%= link_to witnesses_path, class: "hover:underline" do %>
            <span class="font-bold text-gray-900"><%= current_user.witnesses.count %></span><span class="text-gray-500 ml-0.5">見届け中</span>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- カレンダーヒートマップ -->
  <div class="px-4 py-4 border-b border-gray-100 overflow-hidden">
    <p class="font-bold text-gray-800 text-sm mb-3">宣言カレンダー</p>
    <div data-controller="heatmap" data-heatmap-data-value="<%= @heatmap_data.to_json %>"></div>
  </div>

  <!-- 統計タブ -->
  <div data-controller="tabs">
    <div class="flex border-b border-gray-200 bg-white">
      <button data-tabs-target="tab" data-tab="all" data-action="click->tabs#switch"
        class="flex-1 py-2.5 border-b-2 border-transparent text-gray-500 text-center transition-colors cursor-pointer">
        <p class="text-lg font-bold text-gray-800"><%= @declarations.count %></p>
        <p class="text-xs mt-0.5">宣言</p>
      </button>
      <button data-tabs-target="tab" data-tab="declaring" data-action="click->tabs#switch"
        class="flex-1 py-2.5 border-b-2 border-blue-600 text-blue-600 text-center transition-colors cursor-pointer">
        <p class="text-lg font-bold"><%= @declaring.count %></p>
        <p class="text-xs mt-0.5">宣言中</p>
      </button>
      <button data-tabs-target="tab" data-tab="pending" data-action="click->tabs#switch"
        class="flex-1 py-2.5 border-b-2 border-transparent text-gray-500 text-center transition-colors cursor-pointer">
        <p class="text-lg font-bold text-gray-800"><%= @pending.count %></p>
        <p class="text-xs mt-0.5">未達成</p>
      </button>
      <button data-tabs-target="tab" data-tab="completed" data-action="click->tabs#switch"
        class="flex-1 py-2.5 border-b-2 border-transparent text-gray-500 text-center transition-colors cursor-pointer">
        <p class="text-lg font-bold text-gray-800"><%= @completed.count %></p>
        <p class="text-xs mt-0.5">達成</p>
      </button>
      <div class="flex-1 py-2.5 text-center">
        <p class="text-lg font-bold text-gray-800"><%= @completion_rate %>%</p>
        <p class="text-xs mt-0.5 text-gray-500">達成率</p>
      </div>
    </div>

    <!-- 全宣言パネル -->
    <div data-tabs-target="panel" data-panel="all" class="hidden">
      <% if @declarations.empty? %>
        <div class="text-center py-16 text-gray-400">
          <p class="text-sm">宣言はありません</p>
        </div>
      <% else %>
        <% @declarations.each do |declaration| %>
          <div class="px-4 py-4 border-b border-gray-100 <%= declaration.completed? ? 'bg-blue-50' : (declaration.pending? || declaration.expired?) ? 'bg-red-50' : '' %>">
            <p class="text-gray-800 text-sm leading-relaxed mb-1"><%= declaration.content %></p>
            <div class="flex items-center justify-between">
              <p class="text-gray-400 text-xs"><%= declaration.deadline.strftime("%Y/%m/%d") %></p>
              <% if declaration.witnesses.size > 0 %>
                <span class="text-gray-400 text-xs"><%= declaration.witnesses.size %>人が見届け中</span>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <!-- 宣言中パネル -->
    <div data-tabs-target="panel" data-panel="declaring">
      <% if @declaring.empty? %>
        <div class="text-center py-16 text-gray-400">
          <p class="text-sm">宣言中の宣言はありません</p>
        </div>
      <% else %>
        <% @declaring.each do |declaration| %>
          <div class="px-4 py-4 border-b border-gray-100">
            <p class="text-gray-800 text-sm leading-relaxed mb-1"><%= declaration.content %></p>
            <div class="flex items-center justify-between">
              <p class="text-gray-400 text-xs"><%= declaration.deadline.strftime("%Y/%m/%d") %></p>
              <% if declaration.witnesses.size > 0 %>
                <span class="text-gray-400 text-xs"><%= declaration.witnesses.size %>人が見届け中</span>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <!-- 未達成パネル -->
    <div data-tabs-target="panel" data-panel="pending" class="hidden">
      <% if @pending.empty? %>
        <div class="text-center py-16 text-gray-400">
          <p class="text-sm">未達成の宣言はありません</p>
        </div>
      <% else %>
        <% @pending.each do |declaration| %>
          <div class="px-4 py-4 border-b border-gray-100 bg-red-50">
            <p class="text-gray-800 text-sm leading-relaxed mb-1"><%= declaration.content %></p>
            <div class="flex items-center justify-between">
              <p class="text-gray-400 text-xs"><%= declaration.deadline.strftime("%Y/%m/%d") %></p>
              <% if declaration.witnesses.size > 0 %>
                <span class="text-gray-400 text-xs"><%= declaration.witnesses.size %>人が見届け中</span>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <!-- 達成パネル -->
    <div data-tabs-target="panel" data-panel="completed" class="hidden">
      <% if @completed.empty? %>
        <div class="text-center py-16 text-gray-400">
          <p class="text-sm">達成した宣言はありません</p>
        </div>
      <% else %>
        <% @completed.each do |declaration| %>
          <div class="px-4 py-4 border-b border-gray-100 bg-blue-50">
            <p class="text-gray-800 text-sm leading-relaxed mb-1"><%= declaration.content %></p>
            <div class="flex items-center justify-between">
              <p class="text-gray-400 text-xs"><%= declaration.deadline.strftime("%Y/%m/%d") %></p>
              <span class="flex items-center gap-1 text-green-600 text-xs font-semibold">
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
                達成済み
              </span>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

</div>
