<aside class="hidden md:flex w-64 shrink-0 sticky top-0 h-screen flex-col px-4 py-6 border-r border-gray-200 bg-white">
  <!-- ロゴ -->
  <div class="mb-6 px-2">
    <%= link_to root_path do %>
      <%= image_tag "logo.png", alt: "sengen", class: "h-9 w-auto" %>
    <% end %>
  </div>

  <!-- ナビ -->
  <nav class="flex flex-col gap-1 flex-1">
    <%= link_to declarations_path, class: "flex items-center gap-3 px-3 py-3 rounded-full font-bold hover:bg-gray-100 transition-colors #{request.path == declarations_path ? 'text-blue-600' : 'text-gray-900'}" do %>
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
      </svg>
      <span class="text-base">ホーム</span>
    <% end %>

    <%= link_to search_path, class: "flex items-center gap-3 px-3 py-3 rounded-full font-bold hover:bg-gray-100 transition-colors #{request.path == search_path ? 'text-blue-600' : 'text-gray-900'}" do %>
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
      <span class="text-base">検索</span>
    <% end %>

    <%= link_to notifications_path, class: "flex items-center gap-3 px-3 py-3 rounded-full font-bold hover:bg-gray-100 transition-colors #{request.path == notifications_path ? 'text-blue-600' : 'text-gray-900'}" do %>
      <div class="relative">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
        </svg>
        <span id="notification_badge_sidebar">
          <%= render "shared/notification_badge", user: current_user %>
        </span>
      </div>
      <span class="text-base">通知</span>
    <% end %>

    <%= link_to profile_path, class: "flex items-center gap-3 px-3 py-3 rounded-full font-bold hover:bg-gray-100 transition-colors #{request.path == profile_path ? 'text-blue-600' : 'text-gray-900'}" do %>
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
      </svg>
      <span class="text-base">マイページ</span>
    <% end %>
  </nav>

  <!-- ユーザーメニュー -->
  <div class="relative" data-controller="dropdown">
    <button type="button" data-action="click->dropdown#toggle" class="w-full flex items-center gap-3 px-3 py-3 rounded-full hover:bg-gray-100 transition-colors cursor-pointer focus:outline-none">
      <%= render "shared/avatar", user: current_user %>
      <span class="text-sm font-bold text-gray-900 truncate"><%= current_user.name %></span>
    </button>
    <div data-dropdown-target="menu" class="hidden absolute bottom-14 left-0 w-56 bg-white rounded-xl shadow-lg border border-gray-200 py-1 z-50">
      <%= link_to "メール・パスワード変更", edit_user_registration_path, class: "block px-4 py-3 text-sm text-gray-700 hover:bg-gray-50 border-b border-gray-100" %>
      <%= link_to "使い方ガイド", how_to_use_path, class: "block px-4 py-3 text-sm text-gray-700 hover:bg-gray-50 border-b border-gray-100" %>
      <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "w-full text-left px-4 py-3 text-sm text-gray-700 hover:bg-gray-50 cursor-pointer bg-transparent border-0" %>
    </div>
  </div>
</aside>
