<header class="md:hidden sticky top-0 z-20 bg-white border-b border-gray-200 flex items-center justify-between px-4 h-14">
  <%= link_to root_path do %>
    <%= image_tag "logo.png", alt: "sengen", class: "h-8 w-auto" %>
  <% end %>

  <div class="relative" data-controller="dropdown">
    <button type="button" data-action="click->dropdown#toggle" class="flex items-center justify-center h-9 w-9 rounded-full hover:bg-gray-100 transition-colors focus:outline-none cursor-pointer">
      <%= render "shared/avatar", user: current_user, size: :sm %>
    </button>
    <div data-dropdown-target="menu" class="hidden absolute top-11 right-0 w-52 bg-white rounded-xl shadow-lg border border-gray-200 py-1 z-50">
      <%= link_to "メール・パスワード変更", edit_user_registration_path, class: "block px-4 py-3 text-sm text-gray-700 hover:bg-gray-50 border-b border-gray-100" %>
      <%= link_to "使い方ガイド", how_to_use_path, class: "block px-4 py-3 text-sm text-gray-700 hover:bg-gray-50 border-b border-gray-100" %>
      <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "w-full text-left px-4 py-3 text-sm text-red-600 hover:bg-gray-50 cursor-pointer bg-transparent border-0" %>
    </div>
  </div>
</header>
