<% unread_count = user.notifications.unread.count %>
<% if unread_count > 0 %>
  <span class="absolute -top-1.5 -right-1.5 bg-red-500 text-white text-xs font-bold rounded-full h-4 min-w-4 flex items-center justify-center px-1">
    <%= unread_count > 99 ? "99+" : unread_count %>
  </span>
<% end %>
