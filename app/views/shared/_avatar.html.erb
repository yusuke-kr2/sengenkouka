<% size = local_assigns[:size] || :md %>
<% variant = local_assigns[:variant] || :default %>

<% container_class = case size
   when :sm  then "h-8 w-8"
   when :nav then "h-9 w-9"
   when :lg  then "h-16 w-16"
   else           "h-10 w-10"
   end %>

<% icon_class = case size
   when :sm  then "h-5 w-5"
   when :nav then "h-5 w-5"
   when :lg  then "h-9 w-9"
   else           "h-6 w-6"
   end %>

<% if variant == :bordered %>
  <div class="<%= container_class %> rounded-full overflow-hidden border border-gray-200">
    <% if user.avatar.attached? %>
      <%= image_tag user.avatar, class: "h-full w-full object-cover" %>
    <% else %>
      <div class="h-full w-full bg-gray-100 flex items-center justify-center">
        <svg class="<%= icon_class %> text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
        </svg>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="<%= container_class %> rounded-full bg-gray-100 flex items-center justify-center shrink-0 overflow-hidden">
    <% if user.avatar.attached? %>
      <%= image_tag user.avatar, class: "h-full w-full object-cover" %>
    <% else %>
      <svg class="<%= icon_class %> text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
      </svg>
    <% end %>
  </div>
<% end %>
