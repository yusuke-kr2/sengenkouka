<nav class="fixed top-0 left-0 right-0 z-50 bg-white/75 backdrop-blur-md border-b border-gray-200">
  <div class="mx-auto px-4 h-16 flex justify-between items-center max-w-5xl">
    <%= link_to root_path do %>
      <%= image_tag "logo.png", alt: "sengen", class: "h-9 w-auto" %>
    <% end %>
    <div class="flex items-center gap-4">
      <%= link_to search_path, class: "text-gray-600 hover:text-gray-900 transition-colors" do %>
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      <% end %>
      <%= render "shared/notification_bell" %>

      <div class="relative" data-controller="dropdown">
        <button type="button" data-action="click->dropdown#toggle" class="flex flex-col items-center cursor-pointer focus:outline-none">
          <%= render "shared/avatar", user: current_user, size: :nav, variant: :bordered %>
          <span class="text-xs text-gray-600 mt-0.5 leading-none"><%= current_user.name %></span>
        </button>

        <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-44 bg-white rounded-xl shadow-lg border border-gray-200 py-1 z-50">
          <%= link_to "マイページ", profile_path, class: "block px-4 py-3 text-sm text-gray-700 hover:bg-gray-50 border-b border-gray-100" %>
          <%= link_to "使い方ガイド", how_to_use_path, class: "block px-4 py-3 text-sm text-gray-700 hover:bg-gray-50 border-b border-gray-100" %>
          <%= link_to "メール・パスワード変更", edit_user_registration_path, class: "block px-4 py-3 text-sm text-gray-700 hover:bg-gray-50 border-b border-gray-100" %>
          <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "w-full text-left px-4 py-3 text-sm text-gray-700 hover:bg-gray-50 cursor-pointer bg-transparent border-0" %>
        </div>
      </div>
    </div>
  </div>
</nav>
