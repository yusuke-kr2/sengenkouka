<% content_for :title, "通知 - sengen" %>

<!-- ページタイトル -->
<div class="px-4 py-3 border-b border-gray-200 sticky top-0 bg-white/90 backdrop-blur-md z-10">
  <p class="text-gray-900 text-lg font-bold">通知</p>
</div>

<div class="px-4 py-4 space-y-3">
  <% if @notifications.any? %>
    <% @notifications.each do |notification| %>
      <div class="bg-white rounded-2xl border border-gray-200 p-4 flex items-center gap-3">
        <div class="h-10 w-10 rounded-full flex items-center justify-center shrink-0 overflow-hidden <%= notification.reminder? ? 'bg-orange-100' : 'bg-gray-100' %>">
          <% if notification.reminder? %>
            <svg class="h-6 w-6 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
            </svg>
          <% elsif notification.actor.avatar.attached? %>
            <%= image_tag notification.actor.avatar, class: "h-full w-full object-cover" %>
          <% else %>
            <svg class="h-6 w-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
          <% end %>
        </div>
        <div class="flex-1 min-w-0">
          <% if notification.reminder? %>
            <p class="text-sm text-gray-800">
              <span class="text-gray-500">明日が期限です</span>
            </p>
            <p class="text-sm text-gray-600 truncate mt-0.5">「<%= notification.declaration.content %>」</p>
          <% else %>
            <p class="text-sm text-gray-800">
              <%= link_to notification.actor.name, user_path(notification.actor), class: "font-semibold hover:underline" %>
              <span class="text-gray-500">が宣言しました</span>
            </p>
            <p class="text-sm text-gray-600 truncate mt-0.5">「<%= notification.declaration.content %>」</p>
          <% end %>
          <p class="text-xs text-gray-400 mt-1"><%= time_ago_in_words(notification.created_at) %>前</p>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="text-center py-16 text-gray-400">
      <svg class="h-12 w-12 mx-auto mb-3 text-gray-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
      </svg>
      <p class="text-sm">通知はまだありません</p>
    </div>
  <% end %>
</div>
